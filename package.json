{
  "name": "dsh-session-search-incremental",
  "version": "0.2.1-rc.2",
  "description": "Experimental incremental session search for DSH: bounded background indexing with eventual consistency",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=22.23.0",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.mjs",
    "prepack": "npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "prettier": "3.6.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorwads/dsh-session-search-incremental.git"
  },
  "homepage": "https://github.com/victorwads/dsh-session-search-incremental#readme",
  "bugs": {
    "url": "https://github.com/victorwads/dsh-session-search-incremental/issues"
  },
  "keywords": [
    "dsh",
    "cordis-plugin",
    "session-search",
    "sqlite",
    "incremental-indexing"
  ]
}
